# Environment Configuration for Pain Management Support Group

# Application
APP_NAME="Pain Management Support Group API"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true

# API
API_V1_PREFIX="/api/v1"
HOST="0.0.0.0"
PORT=8000

# Security
SECRET_KEY="your-secret-key-change-this-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pain_management"
DB_ECHO=false

# Redis
REDIS_URL="redis://localhost:6379/0"
CACHE_TTL=300

# CORS
CORS_ORIGINS='["http://localhost:3000", "http://localhost:3001"]'

# OpenAI API
OPENAI_API_KEY="sk-your-openai-api-key-here"
OPENAI_MODEL="gpt-4-turbo-preview"
OPENAI_EMBEDDING_MODEL="text-embedding-3-large"

# Anthropic Claude (alternative)
ANTHROPIC_API_KEY="your-anthropic-key-here"

# Pinecone Vector Database
PINECONE_API_KEY="your-pinecone-api-key"
PINECONE_ENVIRONMENT="us-west1-gcp"
PINECONE_INDEX_NAME="pain-management-docs"
USE_PINECONE=false  # Set to true to use Pinecone instead of ChromaDB

# ChromaDB (local alternative)
CHROMA_DB_PATH="./rag/chromadb"

# RAG Settings
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.7

# Document Processing
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
ALLOWED_EXTENSIONS='[".pdf", ".docx", ".txt", ".md"]'
DOCUMENTS_PATH="./rag/documents"

# Email (optional)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="noreply@painmanagement.com"

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL="INFO"
LOG_FILE="logs/app.log"

# Assessment Settings
PRE_TEST_QUESTIONS=15
POST_TEST_QUESTIONS=15
PASSING_SCORE=70.0

# Session Settings
SESSION_DURATION_MINUTES=150
TOTAL_WEEKS=8
SESSIONS_PER_WEEK=4
